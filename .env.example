# Brevo SMTP Configuration
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@example.com
SMTP_PASSWORD=your_brevo_smtp_api_key

# Notification email for registration and password reset
EMAIL_NOTIFICATION_ADDRESS=admin@example.com

# Frontend URL for email links
# Example: http://localhost:63342/einkaufsliste-git/frontend/index.html
# Production: https://www.theendisnear.de/einkaufsliste/index.html
FRONTEND_BASE_URL=https://www.theendisnear.de/einkaufsliste/index.html
